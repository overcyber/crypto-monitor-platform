      "title": "Spread (bps)",
      "id": 2,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-market"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "sql",
          "rawSql": "SELECT event_time AS time, spread_bps AS value FROM market.microstructure_features FINAL WHERE venue='binance' AND symbol='BTCUSDT' AND $__timeFilter(event_time) ORDER BY event_time"
        }
