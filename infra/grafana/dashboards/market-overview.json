    {
      "type": "stat",
      "title": "Reconciliation mismatches (24h)",
      "id": 4,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-market"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "sql",
          "rawSql": "SELECT count() AS value FROM market.reconciliation_results WHERE status!='ok' AND created_at >= now() - INTERVAL 24 HOUR"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "type": "stat",
      "title": "Alerts (24h)",
      "id": 5,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-market"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "sql",
          "rawSql": "SELECT count() AS value FROM market.alerts FINAL WHERE event_time >= now() - INTERVAL 24 HOUR"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 16
      }
    },
    {
      "type": "stat",
      "title": "Hot events (1h)",
      "id": 6,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-market"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "sql",
          "rawSql": "SELECT uniqExact(event_id) AS value FROM market.events_hot FINAL WHERE event_time >= now() - INTERVAL 1 HOUR"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 16
      }
    },
    {
      "type": "timeseries",
