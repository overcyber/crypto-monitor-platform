# ==============================================================================
# Crypto Monitor Platform v4 - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as required:
#   cp .env.example .env
# Never commit your production .env file with secrets to Git.
# ==============================================================================

# ---- General ----
TZ=UTC
DISPLAY_TIMEZONE=America/Sao_Paulo
COMPOSE_PROJECT_NAME=crypto-monitor-v4
# Bind address for exported host ports (use 127.0.0.1 for local isolation)
BIND_ADDRESS=127.0.0.1

# ---- Host Persistent Bind Mounts ----
# Configure dedicated disk or NVMe mount paths here without changing docker-compose.
SRC_DIR=./src
KAFKA_DATA_DIR=./data/kafka
CLICKHOUSE_DATA_DIR=./data/clickhouse
CLICKHOUSE_LOG_DIR=./data/clickhouse-logs
GARAGE_CONFIG_FILE=./data/garage/config/garage.toml
GARAGE_META_DIR=./data/garage/meta
GARAGE_DATA_DIR=./data/garage/data
LAKEKEEPER_PG_DATA_DIR=./data/lakekeeper-postgres
FLINK_CHECKPOINT_DIR=./data/flink/checkpoints
FLINK_SAVEPOINT_DIR=./data/flink/savepoints
GRAFANA_DATA_DIR=./data/grafana
RECONCILE_DATA_DIR=./data/reconcile
REPLAY_DATA_DIR=./data/replay
TELEGRAM_DATA_DIR=./data/telegram

# ---- Monitored Symbols ----
# Monitored pairs can also be managed dynamically via config/markets.yaml
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
COINBASE_PRODUCTS=BTC-USD,ETH-USD,SOL-USD
MARKET_CONFIG=/opt/app/config/markets.yaml

# ---- Kafka (Redpanda / Apache Kafka) ----
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_BOOTSTRAP=kafka:29092
KAFKA_PARTITIONS=12
KAFKA_RAW_RETENTION_HOURS=24
KAFKA_CLEAN_RETENTION_HOURS=72

# ---- ClickHouse (Hot Serving Tier) ----
CLICKHOUSE_DB=market
CLICKHOUSE_USER=market_app
CLICKHOUSE_PASSWORD=change-me-clickhouse
CLICKHOUSE_GRAFANA_PASSWORD=change-me-grafana-clickhouse
CLICKHOUSE_HOT_RETENTION_DAYS=14
CLICKHOUSE_CANDLE_RETENTION_DAYS=365
CLICKHOUSE_ALERT_RETENTION_DAYS=180
CLICKHOUSE_RECON_RETENTION_DAYS=180
CLICKHOUSE_QUERY_FINAL=true

# ---- Garage S3 / Iceberg (Raw Truth Tier) ----
GARAGE_IMAGE=dxflrs/garage:v2.4.1
# 32-byte hex RPC secret (openssl rand -hex 32)
GARAGE_RPC_SECRET=0000000000000010000000000000000000000000000000000000000000000000
S3_ENDPOINT=http://garage:3900
# Garage convention: GK + 24 hex characters
S3_ACCESS_KEY=GK0123456789abcdef01234567
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_REGION=us-east-1
ICEBERG_BUCKET=market-iceberg
ICEBERG_WAREHOUSE=market-data
# Snapshot maintenance
ICEBERG_SNAPSHOT_MAX_AGE_SECONDS=604800
ICEBERG_MIN_SNAPSHOTS_TO_KEEP=24
ICEBERG_ORPHAN_MIN_AGE_SECONDS=259200

# ---- Lakekeeper REST Catalog (Metadata Store) ----
LAKEKEEPER_PG_USER=lakekeeper
LAKEKEEPER_PG_PASSWORD=change-me-lakekeeper-pg
LAKEKEEPER_PG_DB=lakekeeper
LAKEKEEPER_ENCRYPTION_KEY=change-this-to-a-long-random-secret-at-least-32-characters
LAKEKEEPER_VERSION=v0.13.6

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---- Service Ports (Host Bind) ----
MONITOR_API_PORT=8081
ANALYTICS_API_PORT=8082
FLINK_UI_PORT=8083
REPLAY_API_PORT=8084
WEB_UI_PORT=8090
GRAFANA_PORT=3001
S3_API_PORT=8333
LAKEKEEPER_PORT=8181
CLICKHOUSE_HTTP_PORT=8123
KAFKA_EXTERNAL_PORT=9092
KAFKA_EXTERNAL_HOST=localhost

# ---- Stream vs Batch Reconciliation ----
RECONCILE_INTERVAL_SECONDS=300
RECONCILE_LOOKBACK_MINUTES=15
RECONCILE_SETTLE_DELAY_SECONDS=45
RECONCILE_TOLERANCE_COUNT=0
RECONCILE_TOLERANCE_VOLUME_PCT=0.0001
RECONCILE_TOLERANCE_NOTIONAL_PCT=0.0001

# ---- Deterministic Replay ----
REPLAY_DEFAULT_TOPIC=market.replay
REPLAY_MAX_EVENTS=500000
REPLAY_BATCH_SIZE=5000

# ---- APIs Settings ----
API_RELOAD=true
API_MAX_HISTORY_ROWS=10000
ANALYTICS_DEFAULT_BARS=300

# ---- Order Book Reconstruction (Microstructure) ----
BOOK_MAX_LEVELS=1000
BOOK_FEATURE_LEVELS=20
BOOK_TRADE_WINDOW_SECONDS=60
BOOK_DEDUP_EVENTS=50000

# ---- Candle Materialization ----
CANDLE_WORKER_INTERVAL_SECONDS=15
CANDLE_RECOMPUTE_MINUTES=10
CANDLE_BACKFILL_DAYS=30

# ---- Alert Rules ----
ALERT_CONFIG=/opt/app/config/alerts.yaml
ALERT_CONFIG_RELOAD_SECONDS=5

# ---- Compose Engine ----
COMPOSE_PARALLEL_LIMIT=1

# ---- Telegram Bot (Optional) ----
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_ALLOWED_CHAT_IDS=your-telegram-chat-id
TELEGRAM_CONFIG=/opt/app/config/telegram.yaml
TELEGRAM_STATE=/opt/app/data/telegram/state.json
TELEGRAM_POLL_TIMEOUT_SECONDS=30

# ---- Web UI Configuration ----
WEB_UI_CONFIG_WRITE_ENABLED=true
# Generated with: openssl rand -hex 32
WEB_UI_ADMIN_TOKEN=your-random-32-char-token-here
WEB_UI_REFRESH_SECONDS=5

# ---- Internal Service URLs (Container Network) ----
MONITOR_API_INTERNAL_URL=http://monitor-api:8081
ANALYTICS_API_INTERNAL_URL=http://analytics-api:8082
REPLAY_API_INTERNAL_URL=http://replay-api:8084
FLINK_INTERNAL_URL=http://flink-jobmanager:8081
LAKEKEEPER_INTERNAL_URL=http://lakekeeper:8181
GRAFANA_INTERNAL_URL=http://grafana:3000
