        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-market"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "sql",
          "rawSql": "SELECT open_time AS time, volume AS value FROM market.candles_1m FINAL WHERE venue='binance' AND symbol='BTCUSDT' AND $__timeFilter(open_time) ORDER BY open_time"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
    {
      "type": "table",
      "title": "Latest alerts",
      "id": 8,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-market"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "sql",
          "rawSql": "SELECT event_time,rule_id,venue,symbol,field,operator,threshold,observed FROM market.alerts FINAL WHERE $__timeFilter(event_time) ORDER BY event_time DESC LIMIT 50"
