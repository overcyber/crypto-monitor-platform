      },
      "targets": [
        {
          "refId": "A",
          "queryType": "sql",
          "rawSql": "SELECT event_time AS time, price AS value FROM market.events_hot FINAL WHERE venue='binance' AND symbol='BTCUSDT' AND event_type='trade' AND $__timeFilter(event_time) ORDER BY event_time"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
