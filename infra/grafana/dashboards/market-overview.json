      "id": 3,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-market"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "sql",
          "rawSql": "SELECT event_time AS time, ofi AS value FROM market.microstructure_features FINAL WHERE venue='binance' AND symbol='BTCUSDT' AND ofi IS NOT NULL AND $__timeFilter(event_time) ORDER BY event_time"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
